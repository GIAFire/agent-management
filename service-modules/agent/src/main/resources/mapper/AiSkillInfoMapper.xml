<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhiran.agent.mapper.AiSkillInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.zhiran.agent.entity.AiSkillInfoEntity">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="description" property="description" />
        <result column="skill_content" property="skillContent" />
        <result column="source" property="source" />
        <result column="metadata_json" property="metadataJson" />
        <result column="risk_level" property="riskLevel" />
        <result column="tags_json" property="tagsJson" />
        <result column="status" property="status" />
    </resultMap>

    <resultMap id="SkillFileMap" type="com.zhiran.agent.entity.DTO.SkillFileDTO">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="description" property="description" />
        <result column="skill_content" property="skillContent" />
        <result column="source" property="source" />
        <result column="risk_level" property="riskLevel" />
        <result column="requires_shell" property="requiresShell" />
        <result column="requires_sandbox" property="requiresSandbox" />
        <result column="tags_json" property="tagsJson" />
        <result column="status" property="status" />
        <collection property="skillFileList" ofType="com.zhiran.agent.entity.DTO.FileDTO">
            <id property="id" column="file_id"/>
            <result property="skillId" column="skill_id"/>
            <result property="fileRole" column="file_role"/>
            <result property="fileName" column="file_name"/>
            <result property="resourcePath" column="resource_path"/>
            <result property="resourceContent" column="resource_content"/>
            <result property="storageKey" column="storage_key"/>
            <result property="workspaceFileId" column="workspace_file_id"/>
        </collection>
    </resultMap>

    <sql id="RuntimeSkillColumns">
        SELECT
            si.id,
            si.source AS name,
            si.description,
            si.skill_content,
            'mysql' AS source,
            si.metadata_json,
            si.risk_level,
            si.tags_json,
            si.status,
            sf.id file_id,
            sf.skill_id skill_id,
            sf.file_role,
            sf.file_name,
            sf.resource_path,
            sf.resource_content
    </sql>

    <sql id="RuntimeSkillJoins">
        FROM
            ai_skill_info si
                INNER JOIN ai_skill_agent_binding sab
                    ON sab.skill_id = si.id
                    AND sab.agent_id = #{agentId}
                    AND sab.agent_config_id = #{agentConfigId}
                    AND sab.tenant_id = #{tenantId}
                    AND sab.deleted = 0
                LEFT JOIN ai_skill_resource sf
                    ON sf.skill_id = si.id
                    AND sf.tenant_id = #{tenantId}
                    AND sf.deleted = 0
    </sql>

    <sql id="RuntimeSkillFilters">
            si.tenant_id = #{tenantId}
            AND si.status = 1
            AND si.deleted = 0
            AND EXISTS (
                SELECT 1
                FROM ai_skill_role sr
                WHERE sr.skill_info_id = si.id
                  AND sr.tenant_id = #{tenantId}
                  AND sr.deleted = 0
                  AND (
                      sr.role_code = '0'
                      <if test="roleCodes != null and roleCodes.size() > 0">
                          OR sr.role_code IN
                          <foreach collection="roleCodes" item="roleCode" open="(" separator="," close=")">
                              #{roleCode}
                          </foreach>
                      </if>
                  )
            )
    </sql>

    <select id="getAgentSkill" resultMap="SkillFileMap">
        <include refid="RuntimeSkillColumns"/>
        <include refid="RuntimeSkillJoins"/>
        WHERE
            <include refid="RuntimeSkillFilters"/>
            AND LOWER(si.source) = LOWER(#{skillCode})
    </select>

    <select id="getAgentSkillName" resultMap="SkillFileMap">
        <include refid="RuntimeSkillColumns"/>
        <include refid="RuntimeSkillJoins"/>
        WHERE
            <include refid="RuntimeSkillFilters"/>
        ORDER BY si.name ASC, si.id ASC, sf.resource_path ASC
    </select>

</mapper>
