<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zw.agent.mapper.AiHttpHeaderMapper">

    <select id="getHeaderList" resultType="com.zw.agent.entity.AiHttpHeaderEntity">
        SELECT
            *
        FROM
        ai_http_header
        WHERE
        source_id = #{sourceId}
        AND tenant_id = #{tenantId}
        AND source = #{source}
        AND deleted = 0
        ORDER BY id
    </select>
</mapper>
